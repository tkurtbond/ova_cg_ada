--  ova_cg_ada: an OVA character generator in Ada, with fltkada (FLTK)
--  for its window and alibfyaml (libfyaml) for its files.  See
--  AGENTS.md and PLAN.md.

with "arg_parser.gpr";
with "libfyaml_ada.gpr";
--  fltkada isn't installed: proj/fltkada_ext.gpr uses it where it is.
with "proj/fltkada_ext.gpr";

project Ova_Cg_Ada is

   --  ova_fmt's sources, used as they are: its Entities reads a
   --  character, its Format_Markdown and Format_Inline print the
   --  Markdown tab's sheet.
   Ova_Fmt_Src := external ("OVA_FMT_SRC", external ("HOME") & "/Repos/RPG/Tools/ova_fmt/src");

   type Mode_Type is ("program", "tests");
   Mode : Mode_Type := external ("OVA_CG_MODE", "program");

   --  C for ova_cg_spawn.c, Ova_Cg.Spawn's part in C.
   for Languages use ("Ada", "C");
   for Object_Dir use "obj";
   for Exec_Dir use ".";

   case Mode is
      when "program" =>
         for Source_Dirs use ("src", Ova_Fmt_Src);
         for Main use ("ova_cg_main.adb");
      when "tests" =>
         for Source_Dirs use ("src", "test", Ova_Fmt_Src);
         for Exec_Dir use "obj";
         --  The GNUmakefile names the test programs (test/test_*.adb).
   end case;

   --  ova_fmt's own command line and main program aren't this one's.
   for Excluded_Source_Files use
     ("ova_fmt_main.adb", "ova_fmt-cli.ads", "ova_fmt-cli.adb");

   package Builder is
      --  The procedure can't be named Ova_Cg: that is the parent
      --  package of Ova_Cg.Rules and the rest, as ova_fmt's is.
      for Executable ("ova_cg_main.adb") use "ova_cg_ada";
      --  fltkada is built against the shared GNAT runtime.
      for Global_Compilation_Switches ("Ada") use ("-shared");
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatwa", "-gnata", "-g");
      for Default_Switches ("C") use ("-std=c11", "-Wall", "-Wextra", "-g", "-O2");
   end Compiler;

   package Binder is
      for Default_Switches ("Ada") use ("-shared", "-Es");
   end Binder;

end Ova_Cg_Ada;
