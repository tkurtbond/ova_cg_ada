--  fltkada as it is already built in its own tree (FLTKADA, default
--  /usr/local/sw/src/tkb/fltkada): Externally_Built, so building
--  ova_cg_ada never compiles or relinks anything in that tree.  Build
--  it there first with `make build-dynamic`.

library project FLTKAda_Ext is

   Root := external ("FLTKADA", "/usr/local/sw/src/tkb/fltkada");

   for Languages use ("Ada");
   for Source_Dirs use (Root & "/spec", Root & "/body");
   for Library_Dir use Root & "/lib";
   for Library_Name use "fltkada";
   for Library_Kind use "dynamic";
   for Externally_Built use "true";

   --  fltk.ads names these with pragma Linker_Options, which reach only a
   --  program that withs FLTK; a test that doesn't still links
   --  libfltkada.so, and that needs them.
   package Linker is
      for Linker_Options use ("-lfltk", "-lfltk_images", "-lfltk_gl");
   end Linker;

end FLTKAda_Ext;
